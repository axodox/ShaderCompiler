<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup>
    <AvailableItemName Include="ShaderGroup">
      <Targets>CompileShaderGroups;MakeShaderGroupsDeployable;CleanShaderGeneratorOutput</Targets>
    </AvailableItemName>
  </ItemGroup>

  <PropertyGroup>
    <ShaderGeneratorPath>$(MSBuildThisFileDirectory)..\..\bin\ShaderGenerator.exe</ShaderGeneratorPath>
  </PropertyGroup>

  <!-- Turn every ShaderGroup into a tracked custom build step, so a change to the shader, any header it
       (transitively) #includes, or the generator itself retriggers only the affected groups.

       Four notes that are load-bearing for incremental builds:

       - The Command must be a SINGLE line. CustomBuild's up-to-date check (GetOutOfDateItems) compares
         the current command against the one recorded in CustomBuild.command.1.tlog; an embedded newline
         round-trips as LF in the tlog while the (CRLF) source produces CRLF, so a multi-line command
         never compares equal and the step would rebuild on every build. The two generator invocations
         are therefore joined with &amp;&amp;.

       - Only the .csg is declared as an output. The generated header is regenerated by the same command,
         but the generator rewrites it only when its content actually changes (so it does not needlessly
         recompile the header's consumers). Declaring the header here would force it newer-than-input on
         every shader edit, defeating that. The header still lives next to the tlogs under $(IntDir), so
         deleting the intermediate directory (which also drops the tlogs) re-runs the step and regenerates it.
         
       - Transitive #include tracking: CustomBuild does NOT discover dependencies via FileTracker (unlike
         ClCompile) - it only tracks declared inputs. So the generator's -r switch writes a dependency file
         ($(IntDir)ShaderGenerator\<name>.d) listing every header the shader transitively #includes, as a
         single ';'-separated line of absolute paths. We read that file (from the previous build) back into
         AdditionalInputs here, which makes a header edit retrigger its group. A newly-added #include is
         covered the first time by the edit to the shader itself (a declared input); thereafter the .d file
         carries it. The .d is consumed by content (not as a tracked input), so rewriting it never loops.

       - The .d must exist before the first build too. GetOutOfDateItems treats an input missing from the
         read tlog as changed, so if the first build declared only the generator (no .d yet) and the second
         one the headers as well, every group would compile twice from clean - costing a full shader pass
         per configuration on CI. A missing .d is therefore written up front by a dependency-only run
         (-r alone only scans the #includes, it does not compile), so the first build already records the
         complete input set. -->
  <Target Name="CompileShaderGroups" BeforeTargets="CustomBuild" Condition="'@(ShaderGroup)' != ''">
    <ItemGroup>
      <ShaderGroup>
        <DependencyFile>$([MSBuild]::NormalizePath($(IntDir), ShaderGenerator, %(Filename).d))</DependencyFile>
      </ShaderGroup>
    </ItemGroup>
    <Exec Condition="!Exists('%(ShaderGroup.DependencyFile)')" Command="$(ShaderGeneratorPath) -i=%(ShaderGroup.Identity) -r=$([MSBuild]::NormalizeDirectory($(IntDir), ShaderGenerator)) %(ShaderGroup.AdditionalArguments)" />
    <ItemGroup>
      <CustomBuild Include="@(ShaderGroup)">
        <Message>Compiling shader group %(Identity)...</Message>
        <Command>$(ShaderGeneratorPath) -i=%(Identity) -h=$([MSBuild]::NormalizeDirectory($(IntDir), ShaderGenerator)) -n=%(HeaderNamespace) -r=$([MSBuild]::NormalizeDirectory($(IntDir), ShaderGenerator)) %(AdditionalArguments) &amp;&amp; $(ShaderGeneratorPath) -i=%(Identity) -o=$([MSBuild]::NormalizeDirectory(%(OutputDirectory))) -p=%(OptimizationLevel) -d=%(IsEmittingDebugSymbols) %(AdditionalArguments)</Command>
        <AdditionalInputs>$(ShaderGeneratorPath)</AdditionalInputs>
        <AdditionalInputs Condition="Exists('%(DependencyFile)')">$(ShaderGeneratorPath);$([System.IO.File]::ReadAllText('%(DependencyFile)').Trim())</AdditionalInputs>
        <Outputs>$([MSBuild]::NormalizePath(%(OutputDirectory), %(Filename).csg))</Outputs>
      </CustomBuild>
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <ContentFilesProjectOutputGroupDependsOn>$(ContentFilesProjectOutputGroupDependsOn);MakeShaderGroupsDeployable;</ContentFilesProjectOutputGroupDependsOn>
  </PropertyGroup>

  <Target Name="MakeShaderGroupsDeployable" BeforeTargets="ClCompile">
    <CreateItem Include="@(ShaderGroup->'%(OutputDirectory)%(Filename).csg')" AdditionalMetadata="DeploymentContent=true">
      <Output TaskParameter="Include" ItemName="None" />
    </CreateItem>
  </Target>

  <Target Name="CleanShaderGeneratorOutput" AfterTargets="Clean">
    <Delete Files="@(ShaderGroup->'%(OutputDirectory)%(Filename).csg')" />
    <Delete Files="@(ShaderGroup->'$(IntDir)ShaderGenerator\%(Filename).h')" />
    <!-- The .d dependency cache is intentionally NOT deleted: like the .tlog files it lives in $(IntDir)
         and is consumed by content, not as a build output. Keeping it across Clean means a clean rebuild
         records the #include set on the first pass instead of needing one extra resync build. -->

  </Target>

</Project>
